diff --git a/cpu-affinity.h b/cpu-affinity.h
new file mode 100644
--- /dev/null
+++ b/cpu-affinity.h
@@ -0,0 +1,82 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef QTC_CPU_AFFINITY_H
+#define QTC_CPU_AFFINITY_H
+
+#include <errno.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <sched.h>
+#include <unistd.h>
+
+struct qtc_cpu { int cpu, package, core; };
+
+/* Preserve ascending CPU order within each SMT layer. Unknown topology is
+ * treated as one distinct core per logical CPU, never guessed from parity. */
+static void qtc_core_first(struct qtc_cpu *cpus, int count, int *order)
+{
+   int out = 0;
+   for (int layer = 0; out < count; ++layer)
+      for (int i = 0; i < count; ++i)
+      {
+         int sibling = 0;
+         for (int j = 0; j < i; ++j)
+            if (cpus[j].package == cpus[i].package &&
+                cpus[j].core == cpus[i].core) ++sibling;
+         if (sibling == layer) order[out++] = cpus[i].cpu;
+      }
+}
+
+static int qtc_topology_id(int cpu, const char *name)
+{
+   char path[160];
+   int id = -1;
+   snprintf(path, sizeof(path), "/sys/devices/system/cpu/cpu%d/topology/%s", cpu, name);
+   FILE *f = fopen(path, "r");
+   if (f) { if (fscanf(f, "%d", &id) != 1) id = -1; fclose(f); }
+   return id;
+}
+
+static int qtc_linux_affinity_map(int *map, int size, uint64_t mask)
+{
+   long configured = sysconf(_SC_NPROCESSORS_CONF);
+   int capacity = configured > 128 ? (int)configured : 128;
+   cpu_set_t *allowed = NULL;
+   size_t bytes = 0;
+   for (;;)
+   {
+      bytes = CPU_ALLOC_SIZE(capacity);
+      allowed = CPU_ALLOC(capacity);
+      if (!allowed) return -1;
+      CPU_ZERO_S(bytes, allowed);
+      if (sched_getaffinity(0, bytes, allowed) == 0) break;
+      int err = errno;
+      CPU_FREE(allowed);
+      if (err != EINVAL || capacity > 1048576) return -1;
+      capacity *= 2;
+   }
+   struct qtc_cpu *cpus = calloc(capacity, sizeof(*cpus));
+   int *order = malloc((size_t)capacity * sizeof(*order));
+   if (!cpus || !order) { free(cpus); free(order); CPU_FREE(allowed); return -1; }
+   int count = 0, complete = 1;
+   for (int cpu = 0; cpu < capacity; ++cpu)
+      if (CPU_ISSET_S(cpu, bytes, allowed) && ((mask >> (cpu & 63)) & 1ULL))
+      {
+         cpus[count].cpu = cpu;
+         cpus[count].package = qtc_topology_id(cpu, "physical_package_id");
+         cpus[count].core = qtc_topology_id(cpu, "core_id");
+         if (cpus[count].package < 0 || cpus[count].core < 0) complete = 0;
+         order[count++] = cpu;
+      }
+   CPU_FREE(allowed);
+   if (count && mask == UINT64_MAX)
+   {
+      if (complete) qtc_core_first(cpus, count, order);
+      else fprintf(stderr, "Affinity: incomplete CPU topology; using allowed CPU-number order\n");
+   }
+   if (count) for (int i = 0; i < size; ++i) map[i] = order[i % count];
+   free(cpus);
+   free(order);
+   return count;
+}
+#endif
diff --git a/tests/affinity-test.c b/tests/affinity-test.c
new file mode 100644
--- /dev/null
+++ b/tests/affinity-test.c
@@ -0,0 +1,33 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#define _GNU_SOURCE
+#include <assert.h>
+#include "../cpu-affinity.h"
+int main(void) {
+ struct qtc_cpu c[80]; int out[160];
+ for(int i=0;i<80;i++) c[i]=(struct qtc_cpu){i,i/40,(i/2)%20};
+ qtc_core_first(c,80,out);
+ for(int i=0;i<40;i++){assert(out[i]==2*i);assert(out[40+i]==2*i+1);}
+ struct qtc_cpu sockets[]={{0,0,0},{1,0,0},{2,1,0},{3,1,0}};
+ qtc_core_first(sockets,4,out); assert(out[0]==0&&out[1]==2&&out[2]==1&&out[3]==3);
+ struct qtc_cpu sparse[]={{1,0,0},{4,0,2},{5,0,2},{70,1,15}};
+ qtc_core_first(sparse,4,out); assert(out[0]==1&&out[1]==4&&out[2]==70&&out[3]==5);
+ int n=qtc_linux_affinity_map(out,160,UINT64_MAX);assert(n>0);
+ cpu_set_t allowed; CPU_ZERO(&allowed);assert(sched_getaffinity(0,sizeof allowed,&allowed)==0);
+ for(int i=0;i<160;i++)assert(CPU_ISSET(out[i],&allowed));
+ for(int i=n;i<160;i++)assert(out[i]==out[i%n]);
+ int first=out[0];
+ uint64_t mask=1ULL<<(first&63);
+ int selected=qtc_linux_affinity_map(out,160,mask);assert(selected>0);
+ for(int i=0;i<160;i++)assert((out[i]&63)==(first&63));
+ assert(qtc_linux_affinity_map(out,160,0)==0);
+ struct qtc_cpu nonadjacent[]={{2,0,4},{5,1,4},{9,0,4},{12,1,4},{17,0,4}};
+ qtc_core_first(nonadjacent,5,out);
+ assert(out[0]==2&&out[1]==5&&out[2]==9&&out[3]==12&&out[4]==17);
+ cpu_set_t one; CPU_ZERO(&one);CPU_SET(first,&one);
+ assert(sched_setaffinity(0,sizeof one,&one)==0);
+ assert(qtc_linux_affinity_map(out,160,UINT64_MAX)==1);
+ for(int i=0;i<160;i++)assert(out[i]==first);
+ assert(sched_setaffinity(0,sizeof allowed,&allowed)==0);
+ puts("PASS: 40-core/80-thread topology, distinct sockets, sparse cpuset, allowed CPUs, oversubscription");
+ return 0;
+}
